# Workspace VSCode
*.code-workspace
# Секреты
.env
# Логи и приватные данные хаба
!/data/.gitkeep
/data/*
# Assets
!/assets/.gitkeep
/assets/*
# Контейнер репозиториев других проектов
!/projects/.gitkeep
/projects/*
# Логи и служебные файлы
*.log
*.ged
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
/.idea/
/.giga*/