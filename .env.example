# Хост Git-системы (по умолчанию gitflic.ru; в будущем: github.com, gitlab.com)
GIT_HOST=gitflic.ru

# Токен для репозитория хаба (sokol491/gitflicProject)
# Получить: https://gitflic.ru → Настройки → API-токены → Создать (права write:project)
GITFLIC_HUB_USER=sokol491
GITFLIC_HUB_TOKEN=hub_token_placeholder

# Токен для проектов в projects/ (любой владелец репозиториев)
# Получить: https://gitflic.ru → Настройки → API-токены → Создать (права read/write:project)
GITFLIC_PROJECT_USER=sokol491
GITFLIC_PROJECT_TOKEN=project_token_placeholder

# Задел на GITVERCE.ru (мульти-хост)
GITVERCE_HUB_USER=placeholder
GITVERCE_HUB_TOKEN=placeholder

# Пароль HTTP Basic Auth для доступа к хабу из LAN
NETWORK_PASSWORD=password_placeholder
