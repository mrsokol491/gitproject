# ==============================================================================
# GitProject Workspace Hub — шаблон переменных окружения
# ==============================================================================
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#   chmod 600 .env
#   nano .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Глобальные настройки
# ------------------------------------------------------------------------------

# Хост Git-системы по умолчанию (используется для новых операций)
GIT_HOST=gitverse.ru

# Список активных хостов (через запятую)
ACTIVE_HOSTS=gitverse.ru,gitflic.ru,git.sourcecraft.dev,github.com,gitlab.com,gitea.com,hub.mos.ru,codeberg.org

# ------------------------------------------------------------------------------
# Обновление самого GitProject (фиксировано, не редактируется)
# Источник: GitVerse (основной)
# ------------------------------------------------------------------------------
HUB_UPDATE_HOST=gitverse.ru
HUB_UPDATE_OWNER=Sokol491
HUB_UPDATE_SLUG=gitproject

# ------------------------------------------------------------------------------
# GitVerse (gitverse.ru) — платформа от Сбера (реестр ПО РФ)
# ------------------------------------------------------------------------------
GITVERSE_HUB_USER=placeholder
GITVERSE_HUB_TOKEN=placeholder
GITVERSE_PROJECT_USER=placeholder
GITVERSE_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# GitFlic (gitflic.ru) — платформа от Астра (реестр ПО РФ)
# ------------------------------------------------------------------------------
GITFLIC_HUB_USER=placeholder
GITFLIC_HUB_TOKEN=placeholder
GITFLIC_PROJECT_USER=placeholder
GITFLIC_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# SourceCraft (git.sourcecraft.dev) — платформа от Яндекса (реестр ПО РФ)
# ------------------------------------------------------------------------------
SOURCECRAFT_HUB_USER=placeholder
SOURCECRAFT_HUB_TOKEN=placeholder
SOURCECRAFT_PROJECT_USER=placeholder
SOURCECRAFT_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# Mos.hub (hub.mos.ru) — Московская облачная платформа (реестр ПО РФ)
# ------------------------------------------------------------------------------
MOSHUB_HUB_USER=placeholder
MOSHUB_HUB_TOKEN=placeholder
MOSHUB_PROJECT_USER=placeholder
MOSHUB_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# GitHub (github.com) — международный Git-хостинг
# ------------------------------------------------------------------------------
GITHUB_HUB_USER=placeholder
GITHUB_HUB_TOKEN=placeholder
GITHUB_PROJECT_USER=placeholder
GITHUB_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# GitLab (gitlab.com) — международный Git-хостинг
# ------------------------------------------------------------------------------
GITLAB_HUB_USER=placeholder
GITLAB_HUB_TOKEN=placeholder
GITLAB_PROJECT_USER=placeholder
GITLAB_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# Codeberg (codeberg.org) — международный Git-хостинг
# ------------------------------------------------------------------------------
CODEBERG_HUB_USER=placeholder
CODEBERG_HUB_TOKEN=placeholder
CODEBERG_PROJECT_USER=placeholder
CODEBERG_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# Gitea (gitea.com) — международный Git-хостинг
# ------------------------------------------------------------------------------
GITEA_HUB_USER=placeholder
GITEA_HUB_TOKEN=placeholder
GITEA_PROJECT_USER=placeholder
GITEA_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# AltLinux Space (altlinux.space) — Git-хостинг ALT Linux на Forgejo (РФ)
# ------------------------------------------------------------------------------
ALTLINUX_HUB_USER=placeholder
ALTLINUX_HUB_TOKEN=placeholder
ALTLINUX_PROJECT_USER=placeholder
ALTLINUX_PROJECT_TOKEN=placeholder

# ------------------------------------------------------------------------------
# Безопасность сети
# ------------------------------------------------------------------------------

# Пароль HTTP Basic Auth для доступа к хабу из LAN
NETWORK_PASSWORD=password_placeholder

# ==============================================================================
# Примечания:
# - Значение "placeholder" равносильно отсутствию токена (helper игнорирует)
# - Токены должны иметь ограниченные права и срок жизни
# - После завершения работ токены отзываются на хосте
# - .env должен иметь права 600: chmod 600 .env
# - Просмотр .env только в маскированном виде:
#   sed -E 's/=(.+)$/=[скрыто]/' ~/gitproject/.env
# - PHP2Shell (CVE-2026-109618/9): убедитесь, что PHP >= 8.1.33 / 8.2.25 / 8.3.12 / 8.4.0+
# ==============================================================================
# ------------------------------------------------------------------------------
# Forgejo (v17.next.forgejo.org) — международный Git-хостинг (форк Gitea)
# ------------------------------------------------------------------------------
FORGEJO_HUB_USER=placeholder
FORGEJO_HUB_TOKEN=placeholder
FORGEJO_PROJECT_USER=placeholder
FORGEJO_PROJECT_TOKEN=placeholder
